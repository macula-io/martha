{
  "_why": "What the Goose engine says about itself, read from its source so the launcher and the adapter derive from the engine and not from a list typed by hand (macula-io/martha#541). Re-record with: npm run record:goose-engine -- <engine checkout> <its commit>.",
  "engine_commit": "12574353e9eca844df1a8fca69d8313329c1dd14",
  "engine_name": "martha-engine",
  "engine_version": "1.60.0",
  "acp_command": "acp",
  "path_root_variable": "GOOSE_PATH_ROOT",
  "slash_commands": {
    "setting": "GOOSE_SLASH_COMMANDS_ENABLED",
    "when_unset": true
  },
  "mode": {
    "setting": "GOOSE_MODE",
    "values": [
      "auto",
      "approve",
      "smart_approve"
    ],
    "when_unset": "auto"
  },
  "platform_extensions": [
    {
      "key": "analyze",
      "default_enabled": true,
      "hidden": false,
      "feature": "tree-sitter"
    },
    {
      "key": "todo",
      "default_enabled": false,
      "hidden": false,
      "feature": null
    },
    {
      "key": "apps",
      "default_enabled": true,
      "hidden": false,
      "feature": "platform-apps"
    },
    {
      "key": "chatrecall",
      "default_enabled": false,
      "hidden": false,
      "feature": "chat-recall"
    },
    {
      "key": "extensionmanager",
      "default_enabled": true,
      "hidden": false,
      "feature": null
    },
    {
      "key": "scheduler",
      "default_enabled": true,
      "hidden": true,
      "feature": "scheduler"
    },
    {
      "key": "summon",
      "default_enabled": true,
      "hidden": false,
      "feature": null
    },
    {
      "key": "summarize",
      "default_enabled": false,
      "hidden": false,
      "feature": null
    },
    {
      "key": "code_execution",
      "default_enabled": false,
      "hidden": false,
      "feature": "code-mode"
    },
    {
      "key": "developer",
      "default_enabled": true,
      "hidden": false,
      "feature": null
    },
    {
      "key": "tom",
      "default_enabled": true,
      "hidden": false,
      "feature": null
    }
  ],
  "permission_options": [
    "allow_always",
    "allow_once",
    "reject_once",
    "reject_always"
  ],
  "openai_provider": {
    "name": "openai",
    "settings": [
      "OPENAI_API_KEY",
      "OPENAI_BASE_URL",
      "OPENAI_HOST",
      "OPENAI_BASE_PATH",
      "OPENAI_ORGANIZATION",
      "OPENAI_PROJECT",
      "OPENAI_CUSTOM_HEADERS",
      "OPENAI_TIMEOUT"
    ],
    "default_base_path": "v1/chat/completions",
    "secrets": [
      "OPENAI_API_KEY",
      "OPENAI_CUSTOM_HEADERS"
    ]
  },
  "subagent_models": {
    "kind": "any_name",
    "names": []
  },
  "hint_files": {
    "setting": "CONTEXT_FILE_NAMES",
    "goose_hints": ".goosehints",
    "agents_md": "AGENTS.md",
    "when_unset": [
      ".goosehints",
      "AGENTS.md"
    ]
  },
  "stdio_extension": {
    "tag": "type",
    "type": "stdio",
    "keys": [
      "name",
      "description",
      "cmd",
      "args",
      "envs",
      "env_keys",
      "timeout",
      "cwd",
      "bundled",
      "available_tools"
    ],
    "disallowed_env": [
      "PATH",
      "PATHEXT",
      "SystemRoot",
      "windir",
      "LD_LIBRARY_PATH",
      "LD_PRELOAD",
      "LD_AUDIT",
      "LD_DEBUG",
      "LD_BIND_NOW",
      "LD_ASSUME_KERNEL",
      "DYLD_LIBRARY_PATH",
      "DYLD_INSERT_LIBRARIES",
      "DYLD_FRAMEWORK_PATH",
      "PYTHONPATH",
      "PYTHONHOME",
      "NODE_OPTIONS",
      "RUBYOPT",
      "GEM_PATH",
      "GEM_HOME",
      "CLASSPATH",
      "GO111MODULE",
      "GOROOT",
      "APPINIT_DLLS",
      "SESSIONNAME",
      "ComSpec",
      "TEMP",
      "TMP",
      "LOCALAPPDATA",
      "USERPROFILE",
      "HOMEDRIVE",
      "HOMEPATH"
    ]
  },
  "tool_call_session_key": "agent-session-id",
  "telemetry": {
    "setting": "GOOSE_TELEMETRY_ENABLED",
    "when_unset": false
  },
  "skills_advertised": {
    "setting": "GOOSE_SKILLS_ADVERTISED",
    "when_unset": true
  },
  "builtin_skills_advertised": {
    "setting": "GOOSE_BUILTIN_SKILLS_ADVERTISED",
    "when_unset": true
  },
  "tool_naming": {
    "meta_path": [
      "goose",
      "toolCall",
      "toolName"
    ],
    "separator": "__",
    "split_at": "first"
  },
  "shell_tool": "shell",
  "developer_tools": [
    {
      "name": "write",
      "params": "FileWriteParams",
      "argument": "path",
      "hints": {
        "read_only": false,
        "destructive": true,
        "open_world": false
      }
    },
    {
      "name": "edit",
      "params": "FileEditParams",
      "argument": "path",
      "hints": {
        "read_only": false,
        "destructive": true,
        "open_world": false
      }
    },
    {
      "name": "shell",
      "params": "ShellParams",
      "argument": "command",
      "hints": {
        "read_only": false,
        "destructive": true,
        "open_world": true
      }
    },
    {
      "name": "tree",
      "params": "TreeParams",
      "argument": "path",
      "hints": {
        "read_only": true,
        "destructive": false,
        "open_world": false
      }
    },
    {
      "name": "read_image",
      "params": "ImageReadParams",
      "argument": "source",
      "hints": {
        "read_only": false,
        "destructive": false,
        "open_world": true
      }
    }
  ],
  "path_resolution": {
    "absolute": "as_given",
    "bases": [
      "working_dir",
      "current_dir",
      "."
    ],
    "trims": false,
    "expands_home": false
  },
  "session_store": {
    "file": "sessions.db",
    "journal_mode": "Wal",
    "table": "sessions",
    "columns": [
      "id",
      "name",
      "description",
      "user_set_name",
      "session_type",
      "working_dir",
      "created_at",
      "updated_at",
      "extension_data",
      "total_tokens",
      "input_tokens",
      "output_tokens",
      "cache_read_tokens",
      "cache_write_tokens",
      "accumulated_total_tokens",
      "accumulated_input_tokens",
      "accumulated_output_tokens",
      "accumulated_cache_read_tokens",
      "accumulated_cache_write_tokens",
      "accumulated_cost",
      "schedule_id",
      "recipe_json",
      "user_recipe_values_json",
      "provider_name",
      "model_config_json",
      "goose_mode",
      "archived_at",
      "project_id",
      "parent_session_id",
      "system_prompt_override",
      "system_prompt_extras_json",
      "container_id"
    ],
    "extension_states": [
      "todo.v0",
      "goal.v0",
      "enabled_extensions.v0",
      "context_relevance.v2"
    ]
  },
  "approve_mode_unasked": {
    "user_permissions": [
      "always_allow"
    ],
    "unadvertised": "request_was_advertised"
  },
  "engine_folders": {
    "under_root": {
      "config": [
        "config"
      ],
      "data": [
        "data"
      ],
      "state": [
        "state"
      ],
      "plugins": [
        ".agents",
        "plugins"
      ],
      "agents": [
        ".agents",
        "agents"
      ],
      "agents_home": [
        ".agents"
      ]
    },
    "without_root": {
      "config": {
        "layout": "config_dir"
      },
      "data": {
        "layout": "data_dir"
      },
      "state": {
        "layout": "state_dir"
      },
      "plugins": {
        "home": [
          ".agents",
          "plugins"
        ]
      },
      "agents": {
        "home": [
          ".agents",
          "agents"
        ]
      },
      "agents_home": {
        "home": [
          ".agents"
        ]
      }
    }
  },
  "secret_storage": {
    "keyring_switch": "GOOSE_DISABLE_KEYRING",
    "file": "secrets.yaml"
  }
}
