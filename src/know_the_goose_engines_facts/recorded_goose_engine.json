{
  "_why": "What the Goose engine says about itself, read from its source so the launcher and the adapter derive from the engine and not from a list typed by hand (macula-io/martha#541). Re-record with: npm run record:goose-engine -- <engine checkout> <its commit>.",
  "engine_commit": "12574353e9eca844df1a8fca69d8313329c1dd14",
  "engine_name": "martha-engine",
  "engine_version": "1.60.0",
  "acp_command": "acp",
  "path_root_variable": "GOOSE_PATH_ROOT",
  "slash_commands": {
    "setting": "GOOSE_SLASH_COMMANDS_ENABLED",
    "when_unset": true
  },
  "mode": {
    "setting": "GOOSE_MODE",
    "values": [
      "auto",
      "approve",
      "smart_approve"
    ],
    "when_unset": "auto"
  },
  "platform_extensions": [
    {
      "key": "analyze",
      "default_enabled": true,
      "hidden": false,
      "feature": "tree-sitter"
    },
    {
      "key": "todo",
      "default_enabled": false,
      "hidden": false,
      "feature": null
    },
    {
      "key": "apps",
      "default_enabled": true,
      "hidden": false,
      "feature": "platform-apps"
    },
    {
      "key": "chatrecall",
      "default_enabled": false,
      "hidden": false,
      "feature": "chat-recall"
    },
    {
      "key": "extensionmanager",
      "default_enabled": true,
      "hidden": false,
      "feature": null
    },
    {
      "key": "scheduler",
      "default_enabled": true,
      "hidden": true,
      "feature": "scheduler"
    },
    {
      "key": "summon",
      "default_enabled": true,
      "hidden": false,
      "feature": null
    },
    {
      "key": "summarize",
      "default_enabled": false,
      "hidden": false,
      "feature": null
    },
    {
      "key": "code_execution",
      "default_enabled": false,
      "hidden": false,
      "feature": "code-mode"
    },
    {
      "key": "developer",
      "default_enabled": true,
      "hidden": false,
      "feature": null
    },
    {
      "key": "tom",
      "default_enabled": true,
      "hidden": false,
      "feature": null
    }
  ],
  "permission_options": [
    "allow_always",
    "allow_once",
    "reject_once",
    "reject_always"
  ],
  "openai_provider": {
    "name": "openai",
    "settings": [
      "OPENAI_API_KEY",
      "OPENAI_BASE_URL",
      "OPENAI_HOST",
      "OPENAI_BASE_PATH",
      "OPENAI_ORGANIZATION",
      "OPENAI_PROJECT",
      "OPENAI_CUSTOM_HEADERS",
      "OPENAI_TIMEOUT"
    ],
    "default_base_path": "v1/chat/completions",
    "secrets": [
      "OPENAI_API_KEY",
      "OPENAI_CUSTOM_HEADERS"
    ]
  },
  "subagent_models": {
    "kind": "any_name",
    "names": []
  },
  "hint_files": {
    "setting": "CONTEXT_FILE_NAMES",
    "goose_hints": ".goosehints",
    "agents_md": "AGENTS.md",
    "when_unset": [
      ".goosehints",
      "AGENTS.md"
    ]
  },
  "stdio_extension": {
    "tag": "type",
    "type": "stdio",
    "keys": [
      "name",
      "description",
      "cmd",
      "args",
      "envs",
      "env_keys",
      "timeout",
      "cwd",
      "bundled",
      "available_tools"
    ],
    "disallowed_env": [
      "PATH",
      "PATHEXT",
      "SystemRoot",
      "windir",
      "LD_LIBRARY_PATH",
      "LD_PRELOAD",
      "LD_AUDIT",
      "LD_DEBUG",
      "LD_BIND_NOW",
      "LD_ASSUME_KERNEL",
      "DYLD_LIBRARY_PATH",
      "DYLD_INSERT_LIBRARIES",
      "DYLD_FRAMEWORK_PATH",
      "PYTHONPATH",
      "PYTHONHOME",
      "NODE_OPTIONS",
      "RUBYOPT",
      "GEM_PATH",
      "GEM_HOME",
      "CLASSPATH",
      "GO111MODULE",
      "GOROOT",
      "APPINIT_DLLS",
      "SESSIONNAME",
      "ComSpec",
      "TEMP",
      "TMP",
      "LOCALAPPDATA",
      "USERPROFILE",
      "HOMEDRIVE",
      "HOMEPATH"
    ]
  },
  "tool_call_session_key": "agent-session-id",
  "skills_advertised": {
    "setting": "GOOSE_SKILLS_ADVERTISED",
    "when_unset": true
  },
  "builtin_skills_advertised": {
    "setting": "GOOSE_BUILTIN_SKILLS_ADVERTISED",
    "when_unset": true
  },
  "tool_naming": {
    "meta_path": [
      "goose",
      "toolCall",
      "toolName"
    ],
    "separator": "__",
    "split_at": "first"
  },
  "shell_tool": "shell",
  "developer_tools": [
    {
      "name": "write",
      "params": "FileWriteParams",
      "argument": "path"
    },
    {
      "name": "edit",
      "params": "FileEditParams",
      "argument": "path"
    },
    {
      "name": "shell",
      "params": "ShellParams",
      "argument": "command"
    },
    {
      "name": "tree",
      "params": "TreeParams",
      "argument": "path"
    },
    {
      "name": "read_image",
      "params": "ImageReadParams",
      "argument": "source"
    }
  ],
  "path_resolution": {
    "absolute": "as_given",
    "bases": [
      "working_dir",
      "current_dir",
      "."
    ],
    "trims": false,
    "expands_home": false
  },
  "secret_storage": {
    "keyring_switch": "GOOSE_DISABLE_KEYRING",
    "file": "secrets.yaml"
  }
}
