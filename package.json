      "src/install_the_pinned_installer",
      "src/install_the_recorded_mesh_server",
      "src/keep_martha_state_outside_the_checkout",
      "src/keep_what_the_owner_signed",
      "src/launch_a_claude_code_member",
      "src/refuse_a_member_writing_owner_memory",
      "src/run_an_owner_signed_command",
      "src/run_the_martha_command",
      "src/run_the_nodes_own_npm_alone",
      "src/start_a_member"
    ],
    "decisionFiles": [
      "src/launch_a_claude_code_member/remember_own_write_of_a_call.ts"
    ],
    "hostCeilings": {
      "src/approve_a_checkouts_config": 69,
      "src/claude_code_host": 1472,
      "src/claude_code_relay": 714,
      "src/declare_a_solo_crew": 84,
