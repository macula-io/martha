      "src/keep_what_the_owner_signed": 97,
      "src/launch_a_claude_code_member": 2809,
      "src/refuse_a_member_writing_owner_memory": 1081,
      "src/run_an_owner_signed_command": 562,
      "src/run_the_martha_command": 457,
      "src/run_the_nodes_own_npm_alone": 164,
      "src/start_a_member": 224,
      "src/crew_files_directory": 155,
      "src/dashboard_rows_directory": 103,
      "src/hear_the_hosts_dialogs": 40,
      "src/linux_process_identity": 274,
      "src/row_streams_directory": 159
    },
    "packageImports": {
      "typescript": "prove_the_core",
      "eslint": "prove_the_core",
      "saxes": "src"
    },
    "loaderImports": {
