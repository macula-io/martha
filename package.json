{
  "name": "martha",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A crew of coding agents. Core first; hosts are thin adapters.",
  "engines": {
    "node": ">=24.18.1"
  },
  "scripts": {
    "test": "node ./prove_the_core/no_test_output_carries_the_environment.ts node --test --test-timeout=60000 --test-force-exit --import=./prove_the_core/fail_a_test_file_that_leaves_something_running.ts 'src/**/*.node-test.ts' 'architecture/**/*.node-test.ts' 'prove_the_core/**/*.node-test.ts' 'rehearse_a_release/**/*.node-test.mjs'",
    "typecheck": "tsc --noEmit",
    "check:private": "node src/check_nothing_private_gets_in/main.ts",
    "check:posted-text": "node src/check_posted_text_carries_nothing_private/main.ts",
    "check:links": "node src/check_every_link_resolves/main.ts",
    "check:logos": "node src/check_the_logos_are_valid_svg/main.ts",
    "check:base-tests": "node src/check_no_test_the_base_passed_goes_missing/main.ts",
    "check:host-ceilings": "node src/check_a_host_directory_stays_under_its_ceiling/main.ts",
    "check:restated-values": "node src/check_no_literal_restates_a_value/main.ts",
    "check:recorded-host-runs": "node src/check_every_recorded_host_test_is_run/main.ts",
    "probe:launch": "node src/probe_launch_hosts/probe_hosts.ts",
    "record:mesh-tools": "node src/record_mesh_server_tools/record_mesh_server_tools.ts",
    "record:claude-code-host": "node src/record_claude_code_host/record_claude_code_host.ts",
    "lint": "eslint . --max-warnings=0",
    "record:ring-results": "node src/record_ring_results/record_ring_results.ts",
    "record:mesh-answers": "node src/record_mesh_answers/record_mesh_answers.ts",
    "watch:shell": "./watch_a_live_launch/watch_a_member_keep_its_shell.sh",
    "watch:crew": "./watch_a_live_launch/watch_two_members_reach_each_other.sh"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "saxes": "^6.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "martha": {
    "hostContract": "src/host_contract",
